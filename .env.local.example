# Eggo Environment Variables
# Copy this file to .env.local and fill in your values
#
# For Netlify deployment: Add these same variables in your Netlify dashboard
# under Site Settings > Environment Variables

# ============================================================================
# Supabase Configuration
# Get these values from your Supabase project's dashboard:
#   Project Settings > API Keys (the "new" panel — URL ends in /api-keys/new)
# ============================================================================

# Public — read by the browser client. Subject to RLS.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only — bypasses RLS. Used by /api/collections (token verification +
# member insert) and /api/remove-background (auth check + Storage upload).
# Must NEVER be sent to the browser or committed: a leaked sb_secret_ key
# grants unrestricted database access to anyone holding it.
SUPABASE_SECRET_KEY=sb_secret_...

# ============================================================================
# Brickset API (recommended - better data coverage)
# Get your API key from: https://brickset.com/tools/webservices/requestkey
# Note: Server-only — proxied through /api/brickset, never exposed to browser.
# ============================================================================
BRICKSET_API_KEY=your-brickset-api-key

# ============================================================================
# Rebrickable API (fallback when Brickset returns no match)
# Get your API key from: https://rebrickable.com/api/
# Set NEXT_PUBLIC_USE_REBRICKABLE=true to use Rebrickable exclusively.
# ============================================================================
# NEXT_PUBLIC_USE_REBRICKABLE=true
NEXT_PUBLIC_REBRICKABLE_API_KEY=your-rebrickable-api-key

# ============================================================================
# rembg.com API (required for background removal on set images)
# Get your API key from: https://www.rembg.com
# Free tier limits resolution to 460x460. Paid tier preserves source resolution.
# ============================================================================
REMBG_API_KEY=your-rembg-api-key

# ============================================================================
# Local dev login (OPTIONAL — local development only)
# A localhost-only backdoor that signs in as a disposable TEST account so UI
# work can be verified in a browser without Google OAuth. NEVER set any of
# these in Netlify/production. The /api/dev/login route is hard-gated to
# NODE_ENV !== 'production' + localhost, so it is permanently 404 in prod even
# if a flag leaks, but keeping these out of prod env is the first line.
#
# Setup:
#   1. Apply migration 0008_add_seed_flag_to_collections.sql to your project.
#   2. Set the flags + a throwaway test email/password below.
#   3. Set DEV_LOGIN_SOURCE_EMAIL to the real account to clone FROM.
#   4. Run: node scripts/seed-test-account.mjs   (creates the test user flagged
#      app_metadata.seed = true and clones the source account's collections +
#      sets into it, flagged is_seed_data = true)
#   5. Visit http://localhost:3000/dev-login to sign in as the test account.
#
# The seed/login/teardown all require the test user to be flagged seed, so a
# misconfigured DEV_LOGIN_EMAIL pointing at a real account is never touched.
# Remove everything with: node scripts/teardown-test-account.mjs
# ============================================================================
# DEV_LOGIN_ENABLED=true
# NEXT_PUBLIC_DEV_LOGIN_ENABLED=true
# DEV_LOGIN_SOURCE_EMAIL=you@example.com
# DEV_LOGIN_EMAIL=eggo-dev-test@example.com
# DEV_LOGIN_PASSWORD=choose-a-throwaway-password
